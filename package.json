{
  "name": "github-streak-stats-action",
  "version": "1.0.0",
  "description": "GitHub Action to generate streak stats SVG for your profile README",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --sourcemap --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "lint": "eslint src/**/*.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/be-next/github-streak-stats-action.git"
  },
  "keywords": [
    "github",
    "action",
    "streak",
    "stats",
    "profile",
    "readme"
  ],
  "author": "Jerome Ramette",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {
    "undici": "^8.0.0"
  }
}
